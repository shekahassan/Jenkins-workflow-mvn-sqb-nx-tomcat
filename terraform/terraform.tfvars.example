aws_region           = "us-east-2"
key_name             = "maven-keypair"
ssh_private_key_path = "~/.ssh/maven-keypair.pem"

# Restrict these to your trusted public IP/CIDR before production use.
ssh_allowed_cidr     = "0.0.0.0/0"
service_allowed_cidr = "0.0.0.0/0"

nexus_instance_type        = "m7i-flex.large"
sonarqube_instance_type    = "m7i-flex.large"
tomcat_maven_instance_type = "m7i-flex.large"
